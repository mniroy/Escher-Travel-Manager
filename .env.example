# ==================================================
# Escher Travel Manager - Self-Hosted Configuration
# ==================================================

# Server Port (Default: 3000)
PORT=3000

# Self-Hosted PostgreSQL Configuration
POSTGRES_USER=escher
POSTGRES_PASSWORD=escherpassword
POSTGRES_DB=escher_travel

# Optional: External PostgreSQL URL (Leave blank to use Docker Compose postgres)
# DATABASE_URL=postgres://escher:escherpassword@postgres:5432/escher_travel

# Google Maps & Google Places API Keys (Required for Maps, Places search & Route optimization)
GOOGLE_PLACES_API_KEY=your-google-places-api-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Google Gemini API Key (Required for AI travel document scanning & parsing)
GOOGLE_GENERATIVE_AI_API_KEY=your-gemini-api-key
